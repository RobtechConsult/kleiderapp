{
  "expo": {
    "name": "Kleiderapp",
    "slug": "kleiderapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kleiderapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.robtechconsult.kleiderapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.robtechconsult.kleiderapp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotos aus deiner Mediathek werden als Kleidungsstücke importiert.",
          "cameraPermission": "Die Kamera wird genutzt, um Kleidungsstücke zu fotografieren."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dein Standort wird nur für die Wettervorhersage und passende Outfitvorschläge verwendet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/kleiderapp"
    }
  }
}
